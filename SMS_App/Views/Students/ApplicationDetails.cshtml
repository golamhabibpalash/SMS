@model SMS_App.ViewModels.Students.AppliedStudentVM

@{
    Layout = "~/Views/Shared/_LayoutEmpty.cshtml";
}
@{
    ViewData["Title"] = "Application Form Details";
    GlobalUI.PageTitle = ViewBag.Title;

}

<div>
    <form  class="shadow-lg p-3 mb-5 rounded " >
        <input type="hidden" asp-for="Id" />
        <div class="row">
            <div class="col-md-12 text-center">
                <h5 class="alert alert-heading alert-info">Noble Residential High School <br /><span class="h6">Application Form</span></h5>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="AcademicSessionId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input class="form-control-plaintext"  value="@Model.AcademicSession?.Name" readonly />
            </div>
            <label asp-for="InterestedAppliedClassId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input class="form-control-plaintext" value="@Model.InterestedClass?.Name" readonly />
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group row">
                    <label asp-for="NameBangla" class="control-label col-form-label text-md-right col-md-3"></label>
                    <div class="col-md-9">
                        <input asp-for="NameBangla"  class=" form-control-plaintext" placeholder="Name in Bangla">
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="Name" class="control-label col-form-label text-md-right col-md-3"></label>
                    <div class="col-md-9">
                        <input asp-for="Name"  class="form-control-plaintext" placeholder="Name in English">
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="DOB" class="control-label col-form-label text-md-right col-md-3"></label>
                    <div class="col-md-3">
                        <input type="text" asp-for="DOB" class=" form-control-plaintext" />
                    </div>
                    <label asp-for="GenderId" class="control-label col-form-label text-md-right col-md-3">Gender:</label>
                    <div class="col-md-3">
                        <input class="form-control-plaintext" value="@Model.Gender?.Name" readonly/>
                    </div>
                </div>
            </div>

        </div>

        <hr />
        <div class="form-group row">
            <label asp-for="FatherNameBangla" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="FatherNameBangla" class="form-control-plaintext" placeholder="Father Name in Bangla" readonly>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="FatherName" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="FatherName" class="form-control-plaintext" placeholder="Father Name in English" readonly>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="FatherNID" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="FatherNID" class="form-control-plaintext" placeholder="Father's NID" readonly>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="FatherOccupation" class="control-label col-form-label text-md-right col-md-2">Occupation :</label>
            <div class="col-md-2">
                <input asp-for="FatherOccupation" value="@Model.FatherOccupation" class="form-control-plaintext"  readonly/>
            </div>
            <label asp-for="FatherMonthlyIncome" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-2">
                <input asp-for="FatherMonthlyIncome" class="form-control-plaintext" placeholder="Father's Income" readonly>
            </div>
            <label asp-for="FatherPhoneNo" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-2">
                <input asp-for="FatherPhoneNo" class="form-control-plaintext" placeholder="Father's Phone" readonly>
            </div>
        </div>
        <hr />
        <div class="form-group row">
            <label asp-for="MotherNameBangla" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="MotherNameBangla" class="form-control-plaintext" placeholder="Mother's Name in Bangla" readonly>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="MotherName" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="MotherName" class="form-control-plaintext" placeholder="Mother's' Name in English" readonly>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="MotherNID" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="MotherNID" class="form-control-plaintext" placeholder="Mother's NID" readonly>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="MotherOccupation" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-2">
                <input asp-for="MotherOccupation" value="@Model.MotherOccupation" class="form-control-plaintext" readonly />
            </div>
            <label asp-for="MotherMonthlyIncome" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-2">
                <input asp-for="MotherMonthlyIncome" class="form-control-plaintext" placeholder="Mother's Income" readonly>
            </div>
            <label asp-for="MotherPhoneNo" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-2">
                <input asp-for="MotherPhoneNo" class="form-control-plaintext" placeholder="Mother's Phone" readonly>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-10 offset-md-2">
                <h6 class="alert alert-heading alert-info">Present Address</h6>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="PresentAddressArea" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PresentAddressArea" class="form-control-plaintext" placeholder="Village" readonly />
            </div>
            <label asp-for="PresentAddressPO" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PresentAddressPO" class="form-control-plaintext" placeholder="Post office" readonly/>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="PresentUpazilaId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PresentUpazilaId" value="@Model.PresentUpazila?.Name" class="form-control-plaintext" readonly />
            </div>
            <label asp-for="PresentDistrictId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PresentDistrictId"  value="@Model.PresentDistrict?.Name" class="form-control-plaintext" readonly/>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-10 offset-md-2">
                <h6 class="alert alert-heading alert-info">Permanent Address</h6>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="PermanentAddressArea" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PermanentAddressArea" class="form-control-plaintext" placeholder="Village" readonly/>
            </div>
            <label asp-for="PermanentAddressPO" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PermanentAddressPO" class="form-control-plaintext" placeholder="Post office" readonly/>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="PermanentUpazilaId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PermanentUpazilaId" value="@Model.PermanentUpazila?.Name" class="form-control-plaintext" readonly />
            </div>
            <label asp-for="PermanentDistrictId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PermanentDistrictId" value="@Model.PermanentDistrict?.Name" class="form-control-plaintext" readonly />
            </div>
        </div><hr />
        <div class="row">
            <div class="col-md-10 offset-md-2">
                <h6 class="alert alert-heading alert-info">Other's Information</h6>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="NationalityId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="NationalityId" value="@Model.Nationality?.Name" class="form-control-plaintext" readonly />
            </div>
            <label asp-for="ReligionId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="ReligionId" value="@Model.Religion?.Name" class="form-control-plaintext" readonly />
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="AimInLife" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="AimInLife" class="form-control-plaintext" placeholder="Aim In Life"  readonly/>
            </div>
        </div>
        <div class="form-group row">
            <label asp-for="PreviousSchool" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-4">
                <input asp-for="PreviousSchool" class="form-control-plaintext" placeholder="Previous School Name" readonly/>
            </div>
            <label asp-for="PreviousSchoolClassId" class="control-label col-form-label text-md-right col-md-2"></label>
            <div class="col-md-2">
                <input asp-for="PreviousSchoolClassId" value="@Model.PreviousClass?.Name" class="form-control-plaintext" readonly />
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-12 text-center">
                <a class="btn  btn-info btn-sm" asp-action="Application" ><i class="fa fa-home"></i> </a>
                <a class="btn  btn-info btn-sm" asp-action="ApplicationUpsert" asp-route-id="@Model.Id"><i class="fa fa-edit"></i> </a>
            </div>
        </div>
    </form>
</div>

@section Styles{
    <style>
        .form
        {
            background-color: lightcyan;
        }
    </style>
}

