@model SMS.App.ViewModels.PaymentVM.SinglePaymentVM
@{ 
    int trCount = 1;
}
<div class="card">
    <div class="card-header text-center">
        <p class="card-title h5">Payments For @Model.AcademicSession</p>
    </div>
    <table class="table table-bordered" id="accordion">
        <thead class="thead-dark">
            <tr>
                <th width="5">#</th>
                <th>Payment type</th>
                <th class="text-right">Amount</th>
                <th class="text-right">Paid</th>
                <th class="text-right">Due</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.SessionWisePaymentVMs.Count > 0)
            {
                foreach (var item in Model.SessionWisePaymentVMs)
                {
                    <tr class="card-header table-active" data-toggle="collapse" data-target=".tr_@trCount" area-control="collapse_@trCount">
                        <td>@trCount</td>
                        <td>@item.FeeHeadName <span class="badge badge-info">@item.SessionWisePaymentDetails.Count</span></td>
                        <td class="text-right">@item.Amount</td>
                        <td class="text-right">@item.PaidAmount</td>
                        <td class="text-right">@item.Balance</td>
                        <td>@item.Status</td>
                        <td>
                            <button class="btn btn-sm btn-info toggle-icon" data-target=".tr_@trCount">
                               <i class="fa fa-chevron-down"></i>
                            </button> 
                            <span class="btn btn-sm btn-success"><i class="fa fa-print"></i></span>
                        </td>
                    </tr>
                    @if (item.SessionWisePaymentDetails.Count > 0)
                    {
                        foreach (var dItem in item.SessionWisePaymentDetails)
                        {
                            <tr class="collapse tr_@trCount border card-body" data-parent="#accordion">
                                <td colspan="3" class="text-right"> 
                                    <span class="alert">Paid Date: @dItem.PaidDate</span> 
                                    <span class="alert">Payment Receipt: @dItem.ReceiptNo</span>
                                </td>
                                <td class="text-right">@dItem.PaidAmount</td>
                                <td class="text-right">@dItem.DueAmount</td>
                                <td>@dItem.Status</td>
                                <td>
                                    <span class="btn btn-sm btn-success">Receipt <i class="fa fa-print"></i></span>
                                </td>
                            </tr>
                        }
                    }
                    trCount++;
                }
            }
        </tbody>
        <tfoot class="bg-dark text-light">
            <tr class="font-weight-bolder">
                <td colspan="2" class="text-right">Total</td>
                <td  class="text-right">@Model.TotalAmount</td>
                <td  class="text-right">@Model.TotalPaidAmount</td>
                <td  class="text-right">@Model.TotalDueAmount</td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>
</div>
