@model SMS.Entities.AdditionalModels.SinglePaymentVM
@{
    int trCount = 1;
    var dueAmountClass = "";
    var collapsedShow = "";
    collapsedShow = Model.AcademicSession == Model.CurrentSession?"show":"";
    if (Model.TotalDueAmount > 0)
    {
        dueAmountClass = "text-danger bg-light";
    }

}
    <div class="card border-dark">
        <div class="card-header text-center bg-gradient btn" data-toggle="collapse" data-target=".collapsedTable_@Model.AcademicSession" id="accordionCard" area-control="collapse_full">
            <p class="card-title h5">Payments For @Model.AcademicSession <i class="fa fa-chevron-down"></i> </p>
        </div>
        <table class="table table-bordered collapsedTable_@Model.AcademicSession collapse @collapsedShow" id="accordion" data-parent="#accordionCard">
            <thead class="thead-dark">
                <tr>
                    <th style="width:5%">#</th>
                    <th style="width:40%">Payment type</th>
                    <th style="width:10%" class="text-right">Amount</th>
                    <th style="width:10%" class="text-right">Paid</th>
                    <th style="width:10%" class="text-right">Due</th>
                    <th style="width:10%">Status</th>
                    <th style="width:15%">Action</th>    
                    
                </tr>
            </thead>
            <tbody>
                @if (Model.SessionWisePaymentVMs.Count > 0)
                {
                    foreach (var item in Model.SessionWisePaymentVMs)
                    {
                        <tr class="card-header table-active font-weight-bold" data-toggle="collapse" data-target=".tr_@trCount" area-control="collapse_@trCount" aria-expanded="false">
                            <td>@trCount</td>
                            <td>@item.FeeHeadName <span class="badge badge-info">@item.SessionWisePaymentDetails.Count</span></td>
                            <td class="text-right">@item.Amount</td>
                            <td class="text-right">@item.PaidAmount</td>
                            <td class="text-right">@item.Balance</td>
                            @{
                                var iStatusClass = "";
                                if (item.Status == "Paid")
                                {
                                    iStatusClass = "text-success";
                                }
                                else if (item.Status == "Unpaid")
                                {
                                    iStatusClass = "text-danger";
                                }
                                else if (item.Status == "Partial Paid")
                                {
                                    iStatusClass = "text-warning";
                                }
                            }
                            <td class="@iStatusClass">@item.Status</td>
                            <td class="p-0">
                                @if (item.Status == "Paid" || item.Status == "Partial Paid")
                                {
                                    <span class="btn btn-sm btn-info toggle-icon m-2" data-target=".tr_@trCount">
                                        <i class="fa fa-chevron-down"></i>
                                    </span>
                                }                                                        
                            </td>
                        </tr>
                        @if (item.SessionWisePaymentDetails.Count > 0)
                        {
                            <tr class="collapse tr_@trCount border card-body" data-parent="#accordion">
                                <td colspan="7" class="text-center">
                                    <span class="font-weight-bold">Breakdowns</span>
                                </td>
                            </tr>
                            foreach (var dItem in item.SessionWisePaymentDetails)
                            {
                                <tr class="collapse tr_@trCount border card-body  multi-collapse" data-parent="#accordion">
                                    <td colspan="2">
                                        <span class="alert">#@dItem.ReceiptNo</span>
                                        <span class="alert">Paid Date: @dItem.PaidDate</span>
                                    </td>
                                    <td class="text-right">@dItem.PayableAmount</td>
                                    <td class="text-right">@dItem.PaidAmount</td>
                                    <td class="text-right">@dItem.DueAmount</td>
                                    @{ 
                                        var statusClass = "";
                                        if (dItem.Status == "Paid")
                                        {
                                            statusClass = "text-success";
                                        }
                                        else if(dItem.Status == "Unpaid")
                                        {
                                            statusClass = "text-danger";
                                        }
                                        else if(dItem.Status == "Partial Paid")
                                        {
                                            statusClass = "text-warning";
                                        }
                                    }
                                    <td class="@statusClass">@dItem.Status</td>
                                    <td class="p-0">
                                        <button class="btn btn-sm btn-warning">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        @if (item.Status == "Paid" || item.Status == "Partial Paid")
                                        {
                                            <span class="m-0 btn btn-sm btn-success modalViewId" data-paymentid="@dItem.PaymentId" data-target="#exampleModalCenter" data-toggle="modal">Receipt <i class="fa fa-print"></i></span>
                                        }
                                    </td>
                                </tr>
                                if (!string.IsNullOrEmpty(dItem.Remarks))
                                {
                                    <tr class="collapse tr_@trCount border card-body" data-parent="#accordion">
                                        <td class="p-0" colspan="7">Remarks:<span class="font-italic"> @dItem.Remarks</span></td>
                                    </tr>
                                }
                            }
                        }
                        trCount++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            <h6>Data not found</h6>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-dark text-light">
                <tr class="font-weight-bolder">
                    <td colspan="2" class="text-right">Total</td>
                    <td class="text-right">@Model.TotalAmount</td>
                    <td class="text-right">@Model.TotalPaidAmount</td>
                    <td class="text-right @dueAmountClass">@Model.TotalDueAmount</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>

@section Scripts{ 
<script>
    function openReport(paymentId) {
    var iframe = document.getElementById('myIframe');
    iframe.src = '/Reports/ReceiptPaymentView?paymentId=' + paymentId;

    // Set hidden input field value for exporting
    document.getElementById('paymentIdExport').value = paymentId;

    // Show export options
    document.getElementById('exportOptions').style.display = 'flex';

    // Open the modal
    $('#exampleModalCenter').modal('show');
}

</script>
}