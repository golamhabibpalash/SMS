    <style>

        /* Fix for select2 search input */
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            background-color: #fff !important;
            color: #333 !important;
            border: 1px solid #ced4da !important;
            padding: 0.375rem 0.75rem !important;
            border-radius: 0.25rem !important;
            outline: none !important;
        }

            .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field:focus {
                border-color: #86b7fe !important;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
            }

        /* Fix for modal focus issues */
        .modal .select2-container--bootstrap-5 .select2-selection--single,
        .modal .select2-container--bootstrap-5 .select2-selection--multiple {
            pointer-events: auto !important;
        }

        /* Fix for Select2 dropdown behind modal */
        .select2-container--bootstrap-5.select2-container--open {
            z-index: 10000 !important;
        }

        /* Ensure dropdown is above modal */
        .select2-container--bootstrap-5 .select2-dropdown {
            z-index: 10000 !important;
        }

        /* Fix for search input in modal */
        .modal .select2-container--bootstrap-5 .select2-selection--single,
        .modal .select2-container--bootstrap-5 .select2-selection--multiple {
            position: relative;
            z-index: 1;
        }

        /* Ensure dropdown container is above everything */
        .select2-container {
            z-index: 10000 !important;
        }

        /* Fix for Select2 within modals - ensure proper dropdown rendering */
        .modal .select2-results__options {
            max-height: 300px !important;
            overflow-y: auto !important;
        }

        /* Ensure Select2 dropdown doesn't get hidden */
        .select2-container--bootstrap-5 .select2-dropdown {
            display: block !important;
            position: absolute !important;
            visibility: visible !important;
        }

        /* Multiple select styling */
        .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 38px !important;
        }

        /* Override any conflicting theme styles */
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            background-color: #e7f1ff !important;
            border-color: #86b7fe !important;
        }

        /* Fix for dropdown list appearing as inline instead of dropdown */
        .select2-container--bootstrap-5.select2-container--open .select2-dropdown {
            border-top: 1px solid #dee2e6 !important;
        }

        /* Remove any overflow hidden that might be hiding the dropdown */
        .select2-container {
            overflow: visible !important;
        }

        /* Fix Select2 dropdown clipped by modal-content overflow */
        .modal-content:has(.select2),
        .modal-body:has(.select2) {
            overflow: visible !important;
        }
    </style>

    <!-- Tesseract.js for OCR -->
