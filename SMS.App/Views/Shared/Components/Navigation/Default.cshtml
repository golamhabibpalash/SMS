@using Microsoft.AspNetCore.Http
@using SMS.App.ViewModels.ModuleSubModuleVM
@model SiteMap
@inject IHttpContextAccessor HttpContextAccessor
@inject IProjectModuleManager _moduleManager;

<ul class="sidebar-nav" id="appSidebar" data-simplebar>
    @{
        var allModules = await _moduleManager.GetAllAsync();
        var allActiveModules = allModules.ToList().Where(s => s.Status == true);
    }
    @foreach (var module in Model.Modules)
    {
        var canAccessModule = allActiveModules.ToList().Any(s => s.ModuleName == module.SystemName);

        if (!canAccessModule) { continue; }

        <li class="nav-group">
            <a class="nav-link nav-group-toggle" href="#" aria-expanded="false">
                <i class="nav-icon @module.Icon text-light"></i>  @module.DisplayName
            </a>

            <ul class="nav-group-items" style="background:#2F4361">
                @foreach (var sub in module.Submodules)
                {
                    <li class="nav-group">
                        <a class="nav-link nav-group-toggle" href="#" aria-expanded="false" ><i class="nav-icon @sub.Icon fa-1x"></i>  @sub.DisplayName</a>

                        <ul class="nav-group-items" >
                            @foreach (var item in sub.Items)
                            {
                                var hasClaim = string.IsNullOrEmpty(item.Claim)
                                || HttpContextAccessor.HttpContext.User.HasClaim("Permission", item.Claim);
                                if (!hasClaim) { continue; }

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="@item.Controller" asp-action="@item.Action" style="border-bottom:1px solid #29344C">
                                        <i class="nav-icon fas fa-arrow-right"></i> @item.DisplayName
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </li>
    }
</ul>