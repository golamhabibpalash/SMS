@model SMS.Entities.AdditionalModels.StudentVM.ProfileResult

<div class="tab-pane fade" id="results" role="tabpanel" aria-labelledby="results-tab">
    <h2 class="text-danger">This page is under construction</h2>
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Academic Results</h5>
        </div>
        <div class="card-body">
            <div class="row text-center mb-4">
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light">
                        <h3 class="text-success mb-1">3.65</h3>
                        <p class="text-muted mb-0 small">Current CGPA</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light">
                        <h3 class="text-primary mb-1">3.82</h3>
                        <p class="text-muted mb-0 small">Last Semester GPA</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 bg-light">
                        <h3 class="text-info mb-1">5th</h3>
                        <p class="text-muted mb-0 small">Class Rank</p>
                    </div>
                </div>
            </div>

            <h6 class="mb-3">Current Semester Results</h6>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Subject Code</th>
                            <th>Subject Name</th>
                            <th>Credit Hours</th>
                            <th>Grade</th>
                            <th>GPA</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>CS301</td>
                            <td>Data Structures</td>
                            <td>3</td>
                            <td><span class="badge bg-success">A</span></td>
                            <td>3.75</td>
                        </tr>
                        <tr>
                            <td>CS302</td>
                            <td>Database Management</td>
                            <td>3</td>
                            <td><span class="badge bg-success">A+</span></td>
                            <td>4.00</td>
                        </tr>
                        <tr>
                            <td>CS303</td>
                            <td>Web Development</td>
                            <td>3</td>
                            <td><span class="badge bg-primary">A-</span></td>
                            <td>3.50</td>
                        </tr>
                        <tr>
                            <td>CS304</td>
                            <td>Computer Networks</td>
                            <td>3</td>
                            <td><span class="badge bg-info">B+</span></td>
                            <td>3.25</td>
                        </tr>
                        <tr>
                            <td>GE101</td>
                            <td>Business Communication</td>
                            <td>2</td>
                            <td><span class="badge bg-success">A</span></td>
                            <td>3.75</td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2"><strong>Semester GPA</strong></td>
                            <td><strong>14</strong></td>
                            <td colspan="2"><strong>3.82</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-4">
                <button class="btn btn-outline-primary">
                    <i class="bi bi-download me-2"></i>Download Transcript
                </button>
            </div>
        </div>
    </div>
</div>