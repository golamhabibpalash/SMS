@model SMS_App.ViewModels.Students.StudentFeeAllocationVM

@inject UserManager<ApplicationUser> _userManager;

@{
    GlobalUI.PageTitle = "Student Fee Allocation";
    
}

@section Styles{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="row">
    <div class="col-md-8" style="overflow:scroll">
        <table class="table table-striped table-bordered rounded table-responsive-sm" id="studentFeeAllocationTable">
            <thead class="bg-navy-blue text-light">
                <tr>
                    <td>#</td>
                    <td>Class Roll</td>
                    <td width="35%">Student</td>
                    <td width="30%">Fee Type</td>
                    <td width="10%">Session</td>
                    <td width="5%" class="text-right">Amount</td>
                    <td width="5%" class="text-center">Documents</td>
                    <td width="3%" class="text-center">Status</td>
                    <td width="5%" class="text-center">Action</td>
                    <td width="10%" class="text-center">Last updated</td>
                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot>
            </tfoot>
        </table>
    </div>
    <div class="col-md-4 p-2" style=" position:relative" id="studentFeeAllocationCreatePortion">
        <fieldset class="border-primary p-2 border" id="createFieldSetId" style="background-color:antiquewhite;position:sticky;top:50px;right:5px">
            <legend  class="float-none w-auto text-primary px-2"
                        style="font-size: 1.1rem; position: relative;" id="create_update_title_id">Create New Allocation</legend>
            <form asp-action="Create" method="post" id="createUpdateForm">
                <input type="hidden" asp-for="SFAllocation.Id" />

                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end">Academic Class</label>
                    <div class="col-md-8">
                        <select class="form-control" id="academicClassListId" onchange="academicClassIdChange()">
                            <option selected disabled>-Select Class-</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end">Student</label>
                    <div class="col-md-8">
                        <select class="form-control" id="studentId" onchange="handleStudentIdChange()">
                            <option selected disabled>-Select student-</option>
                        </select>
                        <input type="hidden" asp-for="SFAllocation.UniqueId" id="uniqueId" />
                    </div>
                </div>
                <hr  style="border: 1px solid #0d6efd; margin: 10px 0;" />

                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end">Academic Session</label>
                    <div class="col-md-8">
                        <select class="form-control" id="academicSessionListId" onchange="academicSessionIdChange()">
                            <option selected disabled>-Select Session-</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end">Fee Name</label>
                    <div class="col-md-8">
                        <select class="form-control" id="studentFeeHeadId" onchange="handleFeeHeadIdChange()">
                            <option selected disabled>-Select type-</option>
                        </select>
                        <input type="hidden" asp-for="SFAllocation.ClassFeeListId" id="classFeeListId" />
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end">Allocate Amount</label>
                    <div class="col-md-8">
                        <input class="form-control" asp-for="SFAllocation.AllocatedAmount" />
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end">Reference Docs</label>
                    <div class="col-md-8">
                        <input class="" type="file" asp-for="SFAllocation.FeeAllocationApplication" />
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label text-end" asp-for="SFAllocation.IsActive">Is Active</label>
                    <div class="col-md-2 text-left col-form-label">
                        <input class="" asp-for="SFAllocation.IsActive" />
                    </div>
                    <div class="offset-md-4 col-md-2">
                        <input id="submitId" type="submit" value="Submit" class="btn btn-info btn-sm" />
                    </div>
                </div>
            </form>
        </fieldset>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="exampleModalLabel">Do you want to delete this item?</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    X
                </button>
            </div>
            <div class="modal-body">
                <table class="table card">

                    <tr>
                        <td  width="20%" >Student</td>
                        <td width="10%">:</td>
                        <td width="70%" id="deleteStudentName" class="font-weight-bold"></td>
                    </tr>
                    <tr>
                        <td>Class Roll </td>
                        <td>:</td>
                        <td id="deleteClassRoll" class="font-weight-bold"></td>
                    </tr>
                    <tr>
                        <td>Payment Type</td>
                        <td>:</td>
                        <td id="deletePaymentType" class="font-weight-bold"></td>
                    </tr>
                    <tr>
                        <td>Amount </td>
                        <td>:</td>
                        <td id="deleteAmount" class="font-weight-bold"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary col-form-label" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="delete" method="post">
                    <input type="hidden" name="StudentFeeAllocationId" id="StudentFeeAllocationId" />
                    <button type="submit" class="btn btn-danger col-form-label">Delete Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script src="~/js/AlertifyNotify/AlertifyNofify.js"></script>

    <script>
        $(document).ready(async function () {
            await loadAcademicSessions();
            await loadAcademicClasses();
            initializeDataTable();

            $(document).on('click', '.updateBtn', async function () {
                formUIChange();
                var classId = $(this).data("classid");
                var studentId = $(this).data("studentid");
                var feeType = $(this).data("feetype");
                var amount = $(this).data("amount");
                var refDoc = $(this).data("refdoc");
                var isActive = $(this).data("isactive");
                var id = $(this).data("id");

                $("#academicClassListId").val(classId);

                try {
                    await academicClassIdChange();
                    $("#studentId").val(studentId);
                    await handleStudentIdChange();
                    $("#studentFeeHeadId").val(feeType);
                } catch (error) {
                    console.error("An error occurred:", error);
                }

                $('#SFAllocation_AllocatedAmount').val(amount);
                $('#SFAllocation_Id').val(id);

                if (isActive == "True") {
                    $('#SFAllocation_IsActive').prop('checked', true);
                } else {
                    $('#SFAllocation_IsActive').prop('checked', false);
                }
            });

            $(document).on('click', '.deleteBtn', function () {
                var stName = $(this).data('studentname');
                var stClassRoll = $(this).data('classroll');
                var feeTypeName = $(this).data('feetypename');
                var studentId = $(this).data("studentid");
                var classId = $(this).data("classid");
                var feeType = $(this).data("feetype");
                var amount = $(this).data("amount");
                var refDoc = $(this).data("refdoc");
                var isActive = $(this).data("isactive");
                var id = $(this).data("id");

                $('#StudentFeeAllocationId').val(id);
                $('#deleteStudentName').html(stName);
                $('#deleteClassRoll').html(stClassRoll);
                $('#deletePaymentType').html(feeTypeName);
                $('#deleteAmount').html(amount);
            });
        });

        async function loadAcademicSessions() {
            return $.ajax({
                url: '/api/AcademicSessions/GetAllActive',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    $('#academicSessionListId').empty();
                    $('#academicSessionListId').append('<option value="" selected disabled>-Select Session-</option>');
                    $.each(data, function (i, obj) {
                        $('#academicSessionListId').append('<option value="' + obj.id + '">' + obj.name + '</option>');
                    });
                },
                error: function (err) {
                    console.error('Error loading sessions:', err);
                }
            });
        }

        async function loadAcademicClasses() {
            return $.ajax({
                url: '/api/AcademicClasses/GetAllActive',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    $('#academicClassListId').empty();
                    $('#academicClassListId').append('<option value="" selected disabled>-Select Class-</option>');
                    $.each(data, function (i, obj) {
                        $('#academicClassListId').append('<option value="' + obj.id + '">' + obj.name + '</option>');
                    });
                },
                error: function (err) {
                    console.error('Error loading classes:', err);
                }
            });
        }

        async function academicSessionIdChange() {
            var sessionId = @Model.CurrentSession.Id;
            var classId = $('#academicClassListId option:selected').val();
            if (sessionId && classId) {
                await loadStudentsByClassAndSession(sessionId, classId);
            }
        }

        async function academicClassIdChange() {
            var sessionId = @Model.CurrentSession.Id;
            var classId = $('#academicClassListId option:selected').val();
            if (sessionId && classId) {
                console.log(sessionId,'=sesssion & classId = ', classId);
                await loadStudentsByClassAndSession(sessionId, classId);
            }
        }

        async function loadStudentsByClassAndSession(sessionId, classId) {
            console.log('before call to ajax');
            return $.ajax({
                url: '/api/Students/getbyclasswithsessionId',
                data: { academicSessionId: sessionId, academicClassId: classId },
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    console.log('success and return from ajax : ',data);
                    $('#studentId').empty();
                    $('#studentId').append('<option value="" selected disabled>-Select Student-</option>');
                    $.each(data, function (i, obj) {
                        $('#studentId').append('<option value="' + obj.id + '">' + obj.classRoll + '-' + obj.name + '</option>');
                    });
                },
                error: function (err) {
                    console.error('Error loading students:', err);
                }
            });
        }

        async function handleStudentIdChange() {
            var studentId = $('#studentId option:selected').val();
            var sessionId = $('#academicSessionListId option:selected').val();
            if (!studentId || !sessionId) return;

            try {
                var uniqueId = await getUniqueIdByStudentId(studentId);
                $('#uniqueId').val(uniqueId);

                await loadFeeHeadsBySessionAndStudent(uniqueId, sessionId);
            } catch (error) {
                console.error("An error occurred:", error);
            }
        }

        async function loadFeeHeadsBySessionAndStudent(uniqueId, sessionId) {
            return $.ajax({
                url: '/ClassFeeLists/GetClassListByUniqueId',
                data: { uniqueId: uniqueId },
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    $('#studentFeeHeadId').empty();
                    $('#studentFeeHeadId').append('<option value="" selected disabled>-Select type-</option>');
                    $.each(data, function (i, obj) {
                        $('#studentFeeHeadId').append('<option value="' + obj.studentFeeHead.id + '">' + obj.studentFeeHead.name + '</option>');
                    });
                },
                error: function (err) {
                    console.error('Error loading fee heads:', err);
                }
            });
        }

        function getUniqueIdByStudentId(studentId) {
            return $.ajax({
                url: '/api/Students/GetUniqueIdByStudentId',
                data: { id: studentId },
                cache: false,
                type: 'GET',
                dataType: 'JSON',
            });
        }

        function initializeDataTable() {
            $('#studentFeeAllocationTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/api/StudentFeeAllocationApi/GetDataTableData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        return JSON.stringify({
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            searchValue: d.search ? d.search.value : '',
                            orderColumn: d.order && d.order.length > 0 ? d.columns[d.order[0].column].data : '',
                            orderDirection: d.order && d.order.length > 0 ? d.order[0].dir : ''
                        });
                    },
                    error: function (xhr, error, thrown) {
                        console.error('Ajax Error:', xhr.status, xhr.responseText);
                    }
                },
                columns: [
                    { data: null, render: function(data, type, row, meta) { return meta.row + 1; }, orderable: false },
                    { data: 'student.classRoll' },
                    { data: 'student.name' },
                    { data: 'studentFeeHead.name' },
                    { data: 'classFeeList.academicSession.name' },
                    { data: 'allocatedAmount' },
                    { data: 'feeAllocationApplication' },
                    { data: 'isActive' },
                    { data: null, orderable: false },
                    { data: 'editedAt' }
                ]
            });
        }

        async function academicClassIdChange() {
            var sessionId = $('#academicSessionListId option:selected').val();
            var classId = $('#academicClassListId option:selected').val();
            if (sessionId && classId) {
                await loadStudentsByClassAndSession(6, classId);
            }
        }

        function formUIChange() {
            let form = document.getElementById('createUpdateForm');
            form.action = "/StudentFeeAllocations/Edit";
            document.getElementById('studentFeeAllocationCreatePortion').style.backgroundColor = '#2A3F54';

            var fieldSet = document.getElementById('createFieldSetId');
            fieldSet.classList.remove('border-primary');

            var legendData = document.getElementById('create_update_title_id');
            legendData.innerText = "Update Student Allocation";
            legendData.classList.remove('text-primary');

            document.getElementById('create_update_title_id').style.color = "#fff";
            document.getElementById('studentFeeAllocationCreatePortion').style.color = '#fff';
            document.getElementById('submitId').value = 'Update';
        }

        async function handleFeeHeadIdChange() {
            let feeHeadId = $('#studentFeeHeadId option:selected').val();
            let studentId = $('#studentId option:selected').val();
            let classId = $('#academicClassListId option:selected').val();
            console.log('Fee Head:', feeHeadId, 'Student:', studentId, 'Class:', classId);
        }

        function getUniqueIdByStudentId(studentId) {
            return $.ajax({
                url: '/api/Students/GetUniqueIdByStudentId',
                data: { id: studentId },
                cache: false,
                type: 'GET',
                dataType: 'JSON',
            });
        }

        function getClassListByUniqueId(uniqueId) {
            return $.ajax({
                url: '/ClassFeeLists/GetClassListByUniqueId',
                data: { uniqueId: uniqueId },
                cache: false,
                type: 'GET',
                dataType: 'JSON',
            });
        }
    </script>
}