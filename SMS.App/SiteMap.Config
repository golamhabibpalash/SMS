<siteMap>
	<!-- 1. Administration & Setup -->
	<module systemName="Administration" displayName="Admin" Permission="AdministrationPermission" Icon="fas fa-cogs">
		<submodule systemName="InstituteSetup" displayName="Institute" Icon="fas fa-university">
			<item systemName="SchoolProfile" displayName="Profile" Controller="" Action="" Claim=""/>
			<item systemName="SchoolBranches" displayName="Branches" Controller="" Action="" Claim=""/>
			<item systemName="AcademicCalendar" displayName="Calendar" Controller="" Action="" Claim=""/>
			<item systemName="Holidays" displayName="Holidays" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="AcademicSetup" displayName="Academic" Icon="fas fa-graduation-cap">
			<item systemName="AcademicSession" displayName="Session" Controller="" Action="" Claim=""/>
			<item systemName="AcademicClass" displayName="Class" Controller="" Action="" Claim=""/>
			<item systemName="AcademicSection" displayName="Section" Controller="" Action="" Claim=""/>
			<item systemName="AcademicSubject" displayName="Subjects" Controller="" Action="" Claim=""/>
			<item systemName="AcademicCurriculum" displayName="Curriculum" Controller="" Action="" Claim=""/>
			<item systemName="GradingPolicy" displayName="Grading" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="SecuritySetup" displayName="Security" Icon="fas fa-shield-alt">
			<item systemName="ApplicationUser" displayName="Users" Controller="" Action="" Claim=""/>
			<item systemName="ApplicationRole" displayName="Roles" Controller="" Action="" Claim=""/>
			<item systemName="ApplicationPermission" displayName="Permissions" Controller="" Action="" Claim=""/>
			<item systemName="ApplicationAudit" displayName="Audit Logs" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="Integrations" displayName="Integration" Icon="fas fa-plug">
			<item systemName="Localizations" displayName="Languages" Controller="" Action="" Claim=""/>
			<item systemName="ExternalIntegrations" displayName="3rd Party" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="AdminReports" displayName="Reports" Icon="fas fa-chart-bar">
			<item systemName="SetupReport" displayName="Setup Report" Controller="" Action="" Claim=""/>
			<item systemName="UserReport" displayName="User Report" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 2. Student Management -->
	<module systemName="StudentManagement" displayName="Students" Permission="StudentManagementPermission" Icon="fas fa-user-graduate">
		<submodule systemName="StudentRecords" displayName="Records" Icon="fas fa-folder-open">
			<item systemName="StudentProfile" displayName="Profile" Controller="" Action="" Claim=""/>
			<item systemName="StudentEnrollment" displayName="Enrollment" Controller="" Action="" Claim=""/>
			<item systemName="StudentTransfer" displayName="Transfers" Controller="" Action="" Claim=""/>
			<item systemName="StudentDiscipline" displayName="Discipline" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="StudentReports" displayName="Reports" Icon="fas fa-file-alt">
			<item systemName="StudentListReport" displayName="Student List" Controller="" Action="" Claim=""/>
			<item systemName="StudentHistoryReport" displayName="History" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 3. Staff & HR -->
	<module systemName="HR" displayName="HR" Permission="HRPermission" Icon="fas fa-users">
		<submodule systemName="EmployeeManagement" displayName="Employees" Icon="fas fa-user-tie">
			<item systemName="EmployeeProfile" displayName="Profile" Controller="" Action="" Claim=""/>
			<item systemName="EmployeeType" displayName="Types" Controller="" Action="" Claim=""/>
			<item systemName="EmployeeCategory" displayName="Categories" Controller="" Action="" Claim=""/>
			<item systemName="Designation" displayName="Designation" Controller="" Action="" Claim=""/>
			<item systemName="Department" displayName="Department" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="HRReports" displayName="Reports" Icon="fas fa-chart-pie">
			<item systemName="EmployeeListReport" displayName="Employee List" Controller="" Action="" Claim=""/>
			<item systemName="StaffAttendanceReport" displayName="Attendance" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 4. Academic Management -->
	<module systemName="Academics" displayName="Academics" Permission="AcademicsPermission" Icon="fas fa-book">
		<submodule systemName="Classroom" displayName="Classes" Icon="fas fa-chalkboard-teacher">
			<item systemName="ClassSchedule" displayName="Schedule" Controller="" Action="" Claim=""/>
			<item systemName="LessonPlan" displayName="Lesson Plan" Controller="" Action="" Claim=""/>
			<item systemName="Assignments" displayName="Assignments" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="AcademicReports" displayName="Reports" Icon="fas fa-file-alt">
			<item systemName="ScheduleReport" displayName="Schedules" Controller="" Action="" Claim=""/>
			<item systemName="AssignmentReport" displayName="Assignments" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 5. Attendance & Discipline -->
	<module systemName="Attendance" displayName="Attendance" Permission="AttendancePermission" Icon="fas fa-check-square">
		<submodule systemName="AttendanceManagement" displayName="Manage" Icon="fas fa-clipboard-check">
			<item systemName="StudentAttendance" displayName="Students" Controller="" Action="" Claim=""/>
			<item systemName="StaffAttendance" displayName="Staff" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="AttendanceReports" displayName="Reports" Icon="fas fa-chart-line">
			<item systemName="DailyAttendanceReport" displayName="Daily" Controller="" Action="" Claim=""/>
			<item systemName="MonthlyAttendanceReport" displayName="Monthly" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 6. Examination -->
	<module systemName="Exams" displayName="Exams" Permission="ExamsPermission" Icon="fas fa-pencil-alt">
		<submodule systemName="ExamSetup" displayName="Setup" Icon="fas fa-cog">
			<item systemName="ExamType" displayName="Types" Controller="" Action="" Claim=""/>
			<item systemName="ExamSchedule" displayName="Schedules" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="ExamResults" displayName="Results" Icon="fas fa-file-excel">
			<item systemName="MarksEntry" displayName="Marks" Controller="" Action="" Claim=""/>
			<item systemName="GradeSheet" displayName="Grade Sheets" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="ExamReports" displayName="Reports" Icon="fas fa-chart-bar">
			<item systemName="ExamPerformanceReport" displayName="Performance" Controller="" Action="" Claim=""/>
			<item systemName="ResultSummaryReport" displayName="Summary" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 7. Finance & Accounting -->
	<module systemName="Finance" displayName="Finance" Permission="FinancePermission" Icon="fas fa-dollar-sign">
		<submodule systemName="StudentFinance" displayName="Student Fees" Icon="fas fa-money-bill">
			<item systemName="FeeCollection" displayName="Collection" Controller="" Action="" Claim=""/>
			<item systemName="FeeStructure" displayName="Fee Setup" Controller="" Action="" Claim=""/>
			<item systemName="Scholarship" displayName="Scholarship" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="StaffFinance" displayName="Payroll" Icon="fas fa-money-check">
			<item systemName="SalarySetup" displayName="Setup" Controller="" Action="" Claim=""/>
			<item systemName="SalaryPayment" displayName="Payments" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="Accounts" displayName="Accounts" Icon="fas fa-calculator">
			<item systemName="ChartOfAccounts" displayName="Chart" Controller="" Action="" Claim=""/>
			<item systemName="Vouchers" displayName="Vouchers" Controller="" Action="" Claim=""/>
			<item systemName="Ledger" displayName="Ledger" Controller="" Action="" Claim=""/>
			<item systemName="TrialBalance" displayName="Trial Balance" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="FinanceReports" displayName="Reports" Icon="fas fa-file-invoice-dollar">
			<item systemName="FeeReport" displayName="Fee Report" Controller="" Action="" Claim=""/>
			<item systemName="PayrollReport" displayName="Payroll" Controller="" Action="" Claim=""/>
			<item systemName="LedgerReport" displayName="Ledger" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 8. Library -->
	<module systemName="Library" displayName="Library" Permission="LibraryPermission" Icon="fas fa-book-open">
		<submodule systemName="LibrarySetup" displayName="Setup" Icon="fas fa-cog">
			<item systemName="Books" displayName="Books" Controller="" Action="" Claim=""/>
			<item systemName="Categories" displayName="Categories" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="LibraryOperations" displayName="Operations" Icon="fas fa-exchange-alt">
			<item systemName="BookIssue" displayName="Issue" Controller="" Action="" Claim=""/>
			<item systemName="BookReturn" displayName="Return" Controller="" Action="" Claim=""/>
			<item systemName="Fines" displayName="Fines" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="LibraryReports" displayName="Reports" Icon="fas fa-chart-bar">
			<item systemName="BookStockReport" displayName="Stock" Controller="" Action="" Claim=""/>
			<item systemName="UsageReport" displayName="Usage" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 9. Transport -->
	<module systemName="Transport" displayName="Transport" Permission="TransportPermission" Icon="fas fa-bus">
		<submodule systemName="TransportSetup" displayName="Setup" Icon="fas fa-cog">
			<item systemName="Vehicles" displayName="Vehicles" Controller="" Action="" Claim=""/>
			<item systemName="Routes" displayName="Routes" Controller="" Action="" Claim=""/>
			<item systemName="Stops" displayName="Stops" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="TransportOperations" displayName="Operations" Icon="fas fa-route">
			<item systemName="Driver" displayName="Drivers" Controller="" Action="" Claim=""/>
			<item systemName="StudentTransport" displayName="Assignments" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="TransportReports" displayName="Reports" Icon="fas fa-file-alt">
			<item systemName="RouteReport" displayName="Route" Controller="" Action="" Claim=""/>
			<item systemName="UsageReport" displayName="Usage" Controller="" Action="" Claim=""/>
		</submodule>
	</module>

	<!-- 10. Communication -->
	<module systemName="Communication" displayName="Comms" Permission="CommunicationPermission" Icon="fas fa-envelope">
		<submodule systemName="Messaging" displayName="Messaging" Icon="fas fa-comment-alt">
			<item systemName="SMS" displayName="SMS" Controller="" Action="" Claim=""/>
			<item systemName="Email" displayName="Email" Controller="" Action="" Claim=""/>
			<item systemName="NoticeBoard" displayName="Notice" Controller="" Action="" Claim=""/>
		</submodule>
		<submodule systemName="CommunicationReports" displayName="Reports" Icon="fas fa-file-alt">
			<item systemName="MessageLogReport" displayName="Logs" Controller="" Action="" Claim=""/>
		</submodule>
	</module>
</siteMap>