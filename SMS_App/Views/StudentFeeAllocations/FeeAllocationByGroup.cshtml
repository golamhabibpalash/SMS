@{
    GlobalUI.PageTitle = "Group Fee Allocation";
}
@model SMS_App.ViewModels.Students.StudentFeeAllocationGroupVM

@inject UserManager<ApplicationUser> _userManager;

@{
    string lastEditedUser = string.Empty;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="row">
    <form action="FeeAllocationByGroup" method="post" id="myForm">
        <div class="col-md-8">
            <div class="jumbotron" id="jumbotron">
                <h2 class="text-center">Select student from the criterias</h2>
            </div>
            <table class="table table-striped table-bordered rounded table-responsive-sm" id="studentTable" style="display:none">
                <thead class="bg-navy-blue text-light">
                    <tr>
                        <td> <input type="checkbox" id="checkAll" /> </td>
                        <td>Class Roll</td>
                        <td width="35%">Student</td>
                    </tr>
                </thead>
                <tbody id="tbody">
                </tbody>
                <tfoot>
                </tfoot>
            </table>
            <div>
                <input class="btn btn-info" type="submit" id="submitButton" style="display:none" onclick="onSubmitAction()" />
            </div>
        </div>
        <div class="col-md-4 p-2 " style="background-color:antiquewhite;position:relative" id="studentFeeAllocationCreatePortion">
            <fieldset class="border-primary p-2 border" id="createFieldSetId" style="position:sticky;top:50px;right:5px">
                <legend  class="float-none w-auto text-primary px-2"
                        style="font-size: 1.1rem; position: relative;" id="create_update_title_id">Create New Group Allocation</legend>
                <input type="hidden" asp-for="SFAllocation.Id" />
                <div class="form-group row">
                    <label class="col-md-4 col-form-label">Academic Session</label>
                    <div class="col-md-8">
                        <select class="form-control" asp-for="AcademicSessionId" asp-items="Model.AcademicSessionList" onchange="academicSessionIdChange()">
                            <option selected disabled>-Select Session-</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label">Academic Class</label>
                    <div class="col-md-8">
                        <select class="form-control" asp-items="Model.AcademicClassList" asp-for="AcademicClassId" onchange="academicClassIdChange()">
                            <option selected disabled>-Select Class-</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label">Student Type</label>
                    <div class="col-md-8">
                        <select class="form-control" id="residentialNonResidentialId" onchange="residentialNonResidentialIdChange()">
                            <option selected disabled>-Select Type -</option>
                            <option value="1">Residential</option>
                            <option value="0">Non-Residential</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="AcademicSectionId" class="col-md-4 col-form-label">Academic Section</label>
                    <div class="col-md-8">
                        <select class="form-control" onchange="handleSectionIdChange()" asp-for="AcademicSectionId">
                            <option selected disabled>-Select Section-</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label">Fee Name</label>
                    <div class="col-md-8">
                        <select class="form-control" asp-for="FeeHeadId" onchange="handleFeeHeadIdChange()">
                            <option selected disabled>-Select type-</option>
                        </select>
                        <input type="hidden" asp-for="SFAllocation.ClassFeeListId" />
                        <span asp-validation-for="FeeHeadId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-md-4 col-form-label">Allocate Amount</label>
                    <div class="col-md-8">
                        <input class="form-control" asp-for="AllocationAmount" />
                    </div>
                </div>
            </fieldset>
        </div>
    </form>
</div>


<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="exampleModalLabel">Do you want to delete this item?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table class="table card">

                    <tr>
                        <td width="20%">Student</td>
                        <td width="10%">:</td>
                        <td width="70%" id="deleteStudentName" class="font-weight-bold"></td>
                    </tr>
                    <tr>
                        <td>Class Roll </td>
                        <td>:</td>
                        <td id="deleteClassRoll" class="font-weight-bold"></td>
                    </tr>
                    <tr>
                        <td>Payment Type</td>
                        <td>:</td>
                        <td id="deletePaymentType" class="font-weight-bold"></td>
                    </tr>
                    <tr>
                        <td>Amount </td>
                        <td>:</td>
                        <td id="deleteAmount" class="font-weight-bold"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary col-form-label" data-dismiss="modal">Cancel</button>
                <form asp-action="delete" method="post">
                    <input type="hidden" name="StudentFeeAllocationId" id="StudentFeeAllocationId" />
                    <button type="submit" class="btn btn-danger col-form-label">Delete Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/AlertifyNotify/AlertifyNofify.js"></script>
    @if (TempData["notifications"] != null)
    {
        <script type="text/javascript">
            $(function () {
                alertify.success('@TempData["notifications"]');
            });
        </script>
    }
    <script>
        
        
            async function academicClassIdChange() {

                document.getElementById('submitButton').style.display = 'none';
                document.getElementById('studentTable').style.display = 'none';
                document.getElementById('jumbotron').style.display = 'block';

                let id = $('#AcademicClassId option:selected').val();
                let sessionId = $('#AcademicSessionId option:selected').val();
                let isResidential = $('#residentialNonResidentialId option:selected').val();

                $.ajax({
                    url: "/api/academicsections/getbyclasswithsessionId?classId=" + id + "&sessionId=" + sessionId,
                    dataType: "JSON",
                    type: "GET",
                    cache: false,
                    success: function (data) {
                        $('#AcademicSectionId').empty();

                        if (data != null || data != '') {
                            var o = '<option disabled selected value="0">Select Section Name</option>';
                            var o2 = '<option value="all">All Section</option>';
                            $('#AcademicSectionId').append(o);
                            $('#AcademicSectionId').append(o2);
                            $.each(data, function (i, obj) {
                                var op = '<option value="' + obj.id + '">' + obj.name + '</option>';
                                $('#AcademicSectionId').append(op);
                            });
                        }
                        else {
                            var o = '<option disabled selected>Section Not Found</option>';
                            $('#AcademicSectionId').append(o);
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });

                $.ajax({
                    url:"/ClassFeeLists/GetClassListBySessionClassType",
                    dataType: "JSON",
                    type: "GET",
                    cache: false,
                    data: {
                        academicSessionId: sessionId,
                        academicClassId: id,
                        isResidential: isResidential
                    },
                    success: function (data) {
                        $('#FeeHeadId').empty();

                        if (data != null || data != '') {
                            var o = '<option disabled selected value="0">Select Fee Name</option>';
                            $('#FeeHeadId').append(o);
                            $.each(data, function (i, obj) {
                                var op = '<option value="' + obj.studentFeeHead.id + '">' + obj.studentFeeHead.name + '</option>';
                                $('#FeeHeadId').append(op);
                            });
                        }
                        else {
                            var o = '<option disabled selected>Section Not Found</option>';
                            $('#AcademicSectionId').append(o);
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                })
            };

            $('#checkAll').on('change', function () {
                const isChecked = $(this).is(':checked');
                $('.child-checkbox').prop('checked', isChecked);
            });

            function academicSessionIdChange(){
                console.log('session changed');
            }

            function residentialNonResidentialIdChange(){
                console.log('residential changed');
            }

            function handleSectionIdChange(){
                var sectionId = $('#AcademicSectionId option:selected').val();
                $.ajax({
                    url:"/Students/GetAllStudentBySectionId",
                    dataType: "JSON",
                    type: "GET",
                    cache: false,
                    data: {
                        academicSectionId: sectionId
                    },
                    success: function (data) {
                        $('#tbody').empty();

                        if (data != null || data != '') {
                            document.getElementById('submitButton').style.display = 'block';
                            document.getElementById('studentTable').style.display = 'block';
                            document.getElementById('jumbotron').style.display = 'none';

                            $.each(data, function (i, obj) {

                                const tr = document.createElement('tr');

                                const tdCheckBox = document.createElement('td');
                                const tdRoll = document.createElement('td');
                                const tdName = document.createElement('td');

                                // Checkbox: Students[i].IsChecked
                                const inputField = document.createElement('input');
                                inputField.type = 'checkbox';
                                inputField.classList.add('child-checkbox');
                                inputField.name = `Students[${i}].IsChecked`;
                                inputField.value = 'true';
                                tdCheckBox.appendChild(inputField);

                                // Hidden field: Students[i].Student.Id
                                const inputFieldStuId = document.createElement('input');
                                inputFieldStuId.type = 'hidden';
                                inputFieldStuId.name = `Students[${i}].Student.Id`;
                                inputFieldStuId.value = obj.id;
                                tdCheckBox.appendChild(inputFieldStuId);

                                // Hidden field: Students[i].Student.Id
                                const inputFieldStuUniqueId = document.createElement('input');
                                inputFieldStuUniqueId.type = 'hidden';
                                inputFieldStuUniqueId.name = `Students[${i}].Student.UniqueId`;
                                inputFieldStuUniqueId.value = obj.uniqueId;
                                tdCheckBox.appendChild(inputFieldStuUniqueId);

                                tdName.textContent = obj.name;
                                tdRoll.textContent = obj.classRoll;

                                tr.appendChild(tdCheckBox);
                                tr.appendChild(tdRoll);
                                tr.appendChild(tdName);

                                tbody.appendChild(tr);

                            });
                        }
                        else {

                            document.getElementById('submitButton').style.display = 'none';
                            document.getElementById('studentTable').style.display = 'none';
                            document.getElementById('jumbotron').style.display = 'block';
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                })
            }

        function formUIChange() {
            let form = document.getElementById('createUpdateForm');
            form.action = "/StudentFeeAllocations/Edit";
            document.getElementById('studentFeeAllocationCreatePortion').style.backgroundColor = '#2A3F54';

            var fieldSet = document.getElementById('createFieldSetId');
            fieldSet.classList.remove('border-primary');


            var legendData = document.getElementById('create_update_title_id');
            legendData.innerText = "Update Student Allocation";
            legendData.classList.remove('text-primary');

            document.getElementById('create_update_title_id').style.color = "#fff";
            document.getElementById('studentFeeAllocationCreatePortion').style.color = '#fff';
            document.getElementById('submitId').value = 'Update';

            let rDoc = document.getElementById('SFAllocation_FeeAllocationApplication');
        }
        
        function LoadStudentTable(){
            let classId = $('#AcademicClassId option:selected').val();
            let sessionId = $('#AcademicSessionId option:selected').val();
            let isResidential = $('#residentialNonResidentialId option:selected').val();
            let sectionId = $('#AcademicSectionId option:selected').val();

        }

        $(document).ready(function () {

            
            // Add a click event listener to the button
            $(".updateBtn").click(async function () {
                formUIChange();
                var classId = $(this).data("classid");
                var studentId = $(this).data("studentid");
                var feeType = $(this).data("feetype");
                var amount = $(this).data("amount");
                var refDoc = $(this).data("refdoc");
                var isActive = $(this).data("isactive");
                var id = $(this).data("id");

                $("#AcademicClassListId").val(classId);

                try {
                    await academicClassIdChange(); // Wait for the dropdown to be populated
                    $("#SFAllocation_StudentId").val(studentId); // Set the selected student
                    await handleStudentIdChange();
                    $("#SFAllocation_StudentFeeHeadId").val(feeType);
                } catch (error) {
                    console.error("An error occurred:", error);
                }

                $('#SFAllocation_AllocatedAmount').val(amount);
                $('#SFAllocation_Id').val(id);

                if (isActive == "True") {
                    $('#SFAllocation_IsActive').prop('checked', true);
                } else {
                    $('#SFAllocation_IsActive').prop('checked', false);
                }
            });
            $('.deleteBtn').click(function () {
                var stName = $(this).data('studentname');
                var stClassRoll = $(this).data('classroll');
                var feeTypeName = $(this).data('feetypename');
                var studentId = $(this).data("studentid");
                var classId = $(this).data("classid");
                var feeType = $(this).data("feetype");
                var amount = $(this).data("amount");
                var refDoc = $(this).data("refdoc");
                var isActive = $(this).data("isactive");
                var id = $(this).data("id");

                $('#StudentFeeAllocationId').val(id);
                $('#deleteStudentName').html(stName);
                $('#deleteClassRoll').html(stClassRoll);
                $('#deletePaymentType').html(feeTypeName);
                $('#deleteAmount').html(amount);

            });

        });
        async function handleFeeHeadIdChange() {
            let feeheadId = $('#SFAllocation_StudentFeeHeadId option:selected').val();
            let studentId = $('#SFAllocation_StudentId option:selected').val();
            let classId = $('#AcademicClassListId option:selected').val();
            console.log(classId);

        }
        async function handleStudentIdChange() {
            let studentId = $('#SFAllocation_StudentId option:selected').val();

            try {
                // Get Unique ID by Student ID
                let uniqueId = await getUniqueIdByStudentId(studentId);

                // Set the unique ID to the input field
                $('#SFAllocation_UniqueId').val(uniqueId);

                // Get and populate fee heads based on unique ID
                let feeData = await getClassListByUniqueId(uniqueId);
                populateStudentFeeHeadDropdown(feeData);
            } catch (error) {
                console.error("An error occurred:", error);
            }
        }

        // Function to get Unique ID by Student ID
        function getUniqueIdByStudentId(studentId) {
            return $.ajax({
                url: '/api/Students/GetUniqueIdByStudentId',
                data: { id: studentId },
                cache: false,
                type: 'GET',
                dataType: 'JSON',
            });
        }

        // Function to get class list by unique ID
        function getClassListByUniqueId(uniqueId) {
            return $.ajax({
                url: 'ClassFeeLists/GetClassListByUniqueId',
                data: { uniqueId: uniqueId },
                cache: false,
                type: 'GET',
                dataType: 'JSON',
            });
        }

        // Function to populate the Student Fee Head dropdown
        function populateStudentFeeHeadDropdown(feeData) {
            const $feeHeadDropdown = $('#SFAllocation_StudentFeeHeadId');
            $feeHeadDropdown.empty();

            // Add default option
            $feeHeadDropdown.append('<option value="" selected disabled> -Select type - </option>');

            // Append options from feeData
            $.each(feeData, function (i, obj) {
                $feeHeadDropdown.append(`<option value="${obj.studentFeeHead.id}">${obj.studentFeeHead.name}</option>`);
            });
        }

    </script>
    
}