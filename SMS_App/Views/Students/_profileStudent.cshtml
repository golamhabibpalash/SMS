@model SMS.Entities.Student

@{
    string userImage = "/Images/Student/" + Model.Photo;
    string errorImage = Model.GenderId == 1 ? "/images/employee/photo/maleemployee.png" : "/images/employee/photo/femaleemployee.png";
    string studentStatus = Model.Status == true ? "Active" : "Inactive";
}

<div class="card shadow-sm">
    <div class="card-body text-center">
        <img src="@userImage" class="rounded-circle mb-3" alt="Student Photo" width="150" height="150" onerror="this.src='@errorImage'">

        <h4 class="mb-1">@Model.Name</h4>
        <p class="text-muted mb-2">Student ID: @Model.UniqueId</p>
        <span class="badge bg-success mb-3">@studentStatus</span>

        <hr>

        <div class="text-start">
            <p class="mb-2"><i class="bi bi-envelope me-2"></i><strong>Email:</strong> <span class="text-muted small mb-3">@Model.Email</span></p>

            <p class="mb-2"><i class="bi bi-telephone me-2"></i><strong>Phone:</strong> <span class="text-muted small mb-3">@Model.PhoneNo</span> </p>
            <p class="mb-2"><i class="bi bi-telephone me-2"></i><strong>Guardian:</strong> <span class="text-muted small mb-3">@Model.GuardianPhone</span> </p>
            <p class="mb-2"><i class="bi bi-calendar me-2"></i><strong>Date of Birth:</strong> <span class="text-muted small mb-3">@Model.DOB.ToString("MMM dd, yyyy")</span></p>


            <p class="mb-2">
                <i class="bi bi-book me-2"></i><strong>Class:</strong>
                <span class="text-muted small mb-3">@Model.AcademicClass.Name</span>
            </p>

            <p class="mb-2"><i class="bi bi-mortarboard me-2"></i><strong>Section:</strong><span class="text-muted small">@Model.AcademicSection?.Name</span></p>

        </div>
    </div>
</div>