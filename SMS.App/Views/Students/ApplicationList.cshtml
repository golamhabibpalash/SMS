@model IEnumerable<SMS.App.ViewModels.Students.AppliedStudentVM>

@{
    ViewData["Title"] = "Application List";
    GlobalUI.PageTitle = ViewBag.Title;
}
@{
    int sl = 1;
}
<div class="panel-group">
    <div class="panel">
        <div class="panel-title">
            Filter Title
        </div>
        <div class="panel-body">
            Filter Body
        </div>
        <div class="panel-footer">Filter Footer</div>
    </div>

    <div class="panel">
        <div class="panel-title text-center"><h2> Applied Students List</h2></div>
        <div class="panel-body shadow-lg ">
            <table class="table table-hover table-bordered table-responsive-sm table-striped" id="myTable">
                <thead class="bg-blue text-light">
                    <tr>
                        <td>#</td>
                        <td>Students Name</td>
                        <td>Name (Bangla)</td>
                        <td>Father name</td>
                        <td>Father Phone</td>
                        <td>Mother Name</td>
                        <td>Mother Phone</td>
                        <td>Applied For</td>
                        <td>Action</td>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@sl</td>
                                <td>@item.Name</td>
                                <td>@item.NameBangla</td>
                                <td>@item.FatherName</td>
                                <td>@item.FatherPhoneNo</td>
                                <td>@item.MotherName</td>
                                <td>@item.MotherPhoneNo</td>
                                <td>@item.InterestedClass.Name</td>
                                <td>
                                    <span class="btn"><i class="fa fa-eye"></i></span>
                                    <span class="btn"><i class="fa fa-edit"></i></span>
                                </td>
                            </tr>

                            sl++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts{

    <script>
        $(document).ready(function () {
            $('#myTable').DataTable();

            $(function () {
                let saved = '@TempData["saved"]';
                let deleted = '@TempData["deleted"]';
                let edited = '@TempData["update"]';

                if (saved != "") {
                    alertify.success(saved);
                }
                if (deleted != "") {
                    alertify.error("Deleted Successfully");
                }
                if (edited != "") {
                    alertify.message('Updated Successfully');
                }
            });
        });
    </script>
}