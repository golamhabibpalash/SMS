@model SMS.App.ViewModels.AcademicVM.AcademicExamVM

@using System.Globalization

@{
    ViewData["Title"] = "Academic Exams";
    GlobalUI.PageTitle = ViewData["Title"].ToString();
    int sl = 0;
    string styleForCurrentTransaction = string.Empty;
}

<div class="accordion" id="sessionAccordion">
    @foreach (var itemBySession in Model.ExamSessionVM)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="session_@itemBySession.Id">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@itemBySession.Id" aria-expanded="false" aria-controls="collapse_@itemBySession.Id">
                    Session @itemBySession.SessionName
                </button>
            </h2>
            <div id="collapse_@itemBySession.Id" class="accordion-collapse collapse" aria-labelledby="session_@itemBySession.Id" data-bs-parent="#sessionAccordion">
                <div class="accordion-body">
                    @if (itemBySession.ExamGroupDtos.Count > 0)
                    {
                        foreach (var itemByGroup in itemBySession.ExamGroupDtos)
                        {
                            <div class="accordion" id="examGroup_@itemByGroup.Id">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="@itemByGroup.Id _@itemBySession.Id">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@itemByGroup.Id" aria-expanded="false" aria-controls="collapse_@itemByGroup.Id">
                                            @itemByGroup.Name - (Total @itemByGroup.ExaminationDtos?.Sum(exam => exam.ExaminationDetailsDtos?.Count ?? 0) Exam/s)
                                        </button>
                                    </h2>
                                    <div id="collapse_@itemByGroup.Id" class="accordion-collapse collapse" aria-labelledby="@itemByGroup.Id _@itemBySession.Id" data-bs-parent="#collapse_@itemBySession.Id">
                                        <div class="accordion-body">
                                            @foreach (var classGroup in itemByGroup.ExaminationDtos.OrderBy(s => s.ClassId).GroupBy(c => c.ClassName).OrderBy(s => s.FirstOrDefault().ClassId))
                                            {
                                                            int exSL = 0;
                                                <table class="table table-sm table-striped table-bordered table-responsive-sm" id="myTable">
                                                    <thead class="table-info">
                                                        <tr>
                                                            <td colspan="9">@classGroup.Key</td>
                                                        </tr>
                                                        <tr>
                                                            <th class="text-center" style="width:5%">#</th>
                                                            <th style="width:15%">Subject</th>
                                                            <th style="width:10%">Academic Section</th>
                                                            <th style="width:10%">Teacher</th>
                                                            <th style="width:10%">Total Students</th>
                                                            <th style="width:10%">Total Marks</th>
                                                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                                            {
                                                                <th style="width:10%">Lock</th>
                                                            }
                                                            <th class="p-0" style="width:10%">
                                                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                                                {
                                                                    <button class="btn-sm btn-info rounded-pill m-0" id="CreateId" data-toggle="modal" data-target="#createUpdateModal"><i class="fa fa-plus"></i> Add</button>
                                                                }
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var exam in classGroup)
                                                        {
                                                            foreach (var row in exam.ExaminationDetailsDtos)
                                                            {
                                                                <tr style="@styleForCurrentTransaction">
                                                                    <td class="text-center">@{exSL++;}@exSL</td>
                                                                    <td><a asp-action="Details" asp-route-id="@row.Id">@row.SubjectName</a></td>
                                                                    <td>
                                                                        @if (row.SectionName == null)
                                                                        {
                                                                            <span>All</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            @row.SectionName
                                                                        }
                                                                    </td>
                                                                    <td>@row.EmployeeName</td>
                                                                    <td>@row.TotalStudents</td>
                                                                    <td>@row.TotalMarks</td>
                                                                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                                                                    {
                                                                        <td>
                                                                            @(row.IsLocked ? "Locked" : "Unlocked")
                                                                        </td>
                                                                    }
                                                                    <td>
                                                                        <div class="btn-group btn-group-sm" role="group">
                                                                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                                                            {
                                                                                <a class="btn btn-sm rounded mr-1 examEditBtn" id="editBtn_@row.Id" data-examid="@exam.Id" data-groupid="@itemByGroup.Id" data-classid="@exam.ClassId" data-subjectid="@row.SubjectId" data-sectionid="@row.SectionId" data-employeeid="@row.EmployeeId" data-status="@row.IsLocked" data-marks="@row.TotalMarks" data-toggle="modal" data-target="#createUpdateModal" onclick="EditExamClick(@exam.Id)"><i class="fas fa-edit text-dark"></i> </a>
                                                                            }
                                                                            <a class="btn btn-sm rounded mr-1" asp-action="Details" asp-route-id="@exam.Id" data-toggle="tooltip" data-placement="top" title="Details"><i class="fas fa-info-circle text-info"></i> </a>
                                                                            @if (User.IsInRole("SuperAdmin"))
                                                                            {
                                                                                <button class="btn btn-group-sm" data-id="@exam.Id" data-toggle="tooltip" data-placement="right" title="Delete" onclick="DeleteExam(@exam.Id)">
                                                                                    <i class="fas fa-trash text-danger"></i>
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <h2>!!! No examination held in this session</h2>
                    }
                </div>
            </div>
        </div>
    }
</div>