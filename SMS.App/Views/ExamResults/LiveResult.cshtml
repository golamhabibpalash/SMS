@section Scripts{
    <script>
        function examGroupChanged() {
            var examGroupId = $("#ExamGroupId").val();

            if (!examGroupId) return;

            $.ajax({
                url: '/AcademicExams/GetAcademicClassByExamGrId', // 👈 Update with your controller/action
                type: 'GET',
                data: { examGroupId: examGroupId },
                success: function (data) {
                    console.log(data);
                    var classDropdown = $("#AcademicClassId");
                    classDropdown.empty(); // clear previous options
                    classDropdown.append('<option selected disabled>Select Academic Class</option>');

                    $.each(data, function (i, item) {
                        classDropdown.append($('<option>', {
                            value: item.id, // ensure your JSON returns { value: , text: }
                            text: item.name
                        }));
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error loading academic classes:", error);
                }
            });
        }
    </script>

}