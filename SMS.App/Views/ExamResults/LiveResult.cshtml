@using SMS.Entities.AdditionalModels
@model LiveResultVM

<style>
    .student-name-col {
        width: 1%; /* shrink as much as possible */
        white-space: nowrap; /* prevent line breaks */
    }

    .bangla {
        background-color: #ffebcc; /* your color */
        border: 2px solid #ffa500; /* outer border for the column */
    }

    .class-roll-col {
        background-color: #ffebcc; /* your color */
        border: 2px solid #ffa500; /* outer border for the column */
    }

    th.vertical {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
    }
</style>


<form asp-action="LiveResult" asp-controller="ExamResults" method="get">
    <div class="form-row">
        <div class="col-md-2">
            <select class="form-control form-control-sm" asp-items="Model.AcademicExamGroupList" asp-for="ExamGroupId" onchange="examGroupChanged()">
                <option selected disabled>Select Exam Group</option>
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-control form-control-sm" asp-for="AcademicClassId" asp-items="Model.AcademicClassList">
                <option selected disabled>Select Academic Class</option>
            </select>
        </div>
        <div>
            <input type="submit" class="btn btn-info btn-sm" value="Search" onclick="reloadData()">
        </div>
        <div>
            @if (ViewBag.IsLoading == true)
            {
                <a style="display:none" class="btn btn-sm btn-success processResultBtn" asp-controller="ExamResults" asp-action="ProcessResult" asp-route-classId="ViewBag.classId" data-classId="ViewBag.classId" asp-route-groupId="ViewBag.examGroupId" data-groupId="ViewBag.examGroupId" onclick="reloadData()">Process Result</a>

                <a style="display:none" class="btn btn-sm btn-danger deleteResultBtn" asp-controller="ExamResults" asp-action="DeleteResult" asp-route-classId="ViewBag.classId" data-classId="ViewBag.classId" asp-route-groupId="ViewBag.examGroupId" data-groupId="ViewBag.examGroupId" onclick="reloadData()">Delete Result</a>
            }
        </div>
    </div>
</form>

@if (Model.ResultDetails==null || Model.ResultDetails.Count<=0)
{
    <div class="alert alert-warning text-center">
        <span class="h3">
            Nothing Found
        </span>
    </div>
}
else
{
    <div class="">
        <table class="table table-bordered table-responsive table-auto table-striped">
            <thead class="table-info sticky-top" style="top:5% !important">
                <tr>
                    <th colspan="@Model.TotalColumn" class="text-center">@Model.ExamTitle</th>
                </tr>
                <tr>
                    <th rowspan="2" class="text-center">Class Roll</th>
                    <th rowspan="2" class="text-center text-nowrapl">Student Name</th>
                    @foreach (var sub in Model.Subjects)
                    {
                        int colCount = 2 + sub.ExamTypes.Count;
                        <th colspan="@colCount" class="text-center">
                            @sub.SubjectName

                            <p><small>(Highest @sub.HighestMark from @sub.TotalMarks)</small></p>
                        </th>
                    }
                    <th rowspan="2" class="vertical">Final GPA</th>
                    <th rowspan="2" class="vertical">Final Grade</th>
                    <th rowspan="2" class="vertical">Total Marks</th>
                    <th rowspan="2" class="vertical">Attendance(%)</th>
                    <th rowspan="2" class="vertical">Rank</th>
                </tr>
                <tr>
                    @foreach (var item in Model.Subjects)
                    {
                        foreach (var type in item.ExamTypes)
                        {
                            <th class="vertical">@type.ExamType (@type.TotalMarks)</th>
                        }
                        <th class="vertical">marks</th>
                        <th class="vertical">Grade Point</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var studentResult in Model.ResultDetails.OrderBy(s => s.ClassRoll))
                {
                    <tr>
                        <td>@studentResult.ClassRoll</td>
                        <td>@studentResult.StudentName</td>
                        @foreach (var item in studentResult.LiveResultSubjectWises)
                        {
                            if (item.SubjectTypes.Count > 0)
                            {
                                foreach (var types in item.SubjectTypes)
                                {
                                    <td>@types.GetMarks</td>
                                }
                            }
                            <td>@item.ObtainMarks</td>
                            <td>@item.GPA</td>
                        }
                        <td>@studentResult.FinalGPA.ToString("F1")</td>
                        <td>@studentResult.FinalGrade</td>
                        <td>@studentResult.TotalMarks</td>
                        <td>@studentResult.Attendance</td>
                        <td>@studentResult.Rank</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}
