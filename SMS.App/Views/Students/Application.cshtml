@model SMS.App.ViewModels.Students.OnlineAdmissionVM

@inject SignInManager<ApplicationUser> _signInManager;
@inject UserManager<ApplicationUser> _userManager;

@{
    Layout = _signInManager.IsSignedIn(User) ? "~/Views/Shared/_Layout.cshtml" : "~/Views/Shared/_LayoutEmpty.cshtml";
    ViewData["Title"] = "Online Admission";
}
<div class="d-flex flex-column align-items-center justify-content-center" style="height: 100vh;">
    <div class="col-6 text-center">
        <h1 class="mb-4 text-info"><u>Online Admission</u></h1>
        <a class="btn  btn-info" asp-action="ApplicationUpsert">Application Form</a>
        <h6 class="m-3">Already Applied?</h6>
        <form asp-action="Application" method="post">
            <div class="form-group  text-center">
                <div class="">
                    <div class="input-group">
                        <input asp-for="SearchText" class="form-control form-control-sm" id="searchField" placeholder="Search by Name/Phone...">
                        <div class="input-group-append"> <button class="btn btn-primary btn-sm" type="submit"> <i class="fa fa-search"></i> </button> </div>
                    </div>
                </div>
            </div>
        </form>
        <div class="row">
            @if (Model.SearchApplications != null && Model.SearchApplications.Count > 0)
            {
                <table class="table table-bordered table-sm shadow">
                    <thead class="bg-info text-light">
                        <tr>
                            <td>Student Name</td>
                            <td>Father Name</td>
                            <td>Mother Name</td>
                            <td>Status</td>
                            <td>Action</td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SearchApplications)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.FatherName</td>
                                <td>@item.MotherName</td>
                                <td>@item.AppliedStudentStatus</td>
                                <td>
                                    <a class="btn  btn-info btn-sm" asp-action="ApplicationDetails" asp-route-id="@item.Id"><i class="fa fa-eye"></i> </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if(ViewBag.applicationFrom!="get"&& Model.SearchApplications == null)
            {
                <div class="text-center">
                    <span class="text-center">No Found. You may proceed to <a class="" asp-action="ApplicationUpsert">Online Admission</a></span>
                </div>
            }
        </div>

    </div>

</div>



@section Styles{
    <style>
    </style>


}
@section Scripts {
    <script>

    </script>
}
