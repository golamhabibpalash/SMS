@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http

@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager
@inject IInstituteManager _instituteManager
@inject IEmployeeManager _employeeManager
@inject IStudentManager _studentManager
@inject IHttpContextAccessor httpContextAccessor

@{
    var info = await _instituteManager.GetAllAsync();
    if (info.Any())
    {
        var firstInstitute = info.First();
        GlobalUI.InstituteName = firstInstitute.Name;
        GlobalUI.Logo = firstInstitute.Logo;
        GlobalUI.Language = "En";
    }
    string instituteName = GlobalUI.InstituteName ?? "Institute Name";
    string instituteLogo = GlobalUI.Logo ?? "instituteLogo.png";
    var userName = _userManager.GetUserName(User);

    string userImage = "/Images/noProfileImage.png";
    if (_signInManager.IsSignedIn(User))
    {
        var user = await _userManager.GetUserAsync(User);
        if (user.UserType == 's')
        {
            var stu = await _studentManager.GetByIdAsync(user.ReferenceId);
            if (!string.IsNullOrEmpty(stu?.Photo))
                userImage = $"/Images/Student/Photo/{stu.Photo}";
        }
        else if (user.UserType == 'e')
        {
            var emp = await _employeeManager.GetByIdAsync(user.ReferenceId);
            if (!string.IsNullOrEmpty(emp?.Image))
                userImage = $"/Images/Employee/Photo/{emp.Image}";
        }
    }
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(ViewBag.Title != null ? $"{ViewBag.Title} : {instituteName}" : instituteName)</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/x-icon" href="~/Images/Institute/favicon.ico" />
    <link href="~/lib/theme/adminlte/css/index.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/lib/theme/adminlte/css/overlayscrollbars.min.css" rel="stylesheet" />
    <link href="~/lib/theme/adminlte/css/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/theme/adminlte/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/lib/alertify/css/alertify.min.css" rel="stylesheet" />
    <link href="~/css/userProfileOverLay.css" rel="stylesheet" />
    <link href="~/css/custom.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
    <style>
        .sidebar .sidebar-brand .institute-name {
            white-space: normal;
            word-break: break-word;
            font-size: 14px;
            line-height: 1.2;
        }
        .preIcon { width: 25px; }
    </style>
</head>
<body class="layout-fixed sidebar-collapse bg-body-tertiary">
    @if (!_signInManager.IsSignedIn(User))
    {
        <script>window.location.href = "/Accounts/Login";</script>
    }
    <div class="app-wrapper">
        <!-- Header -->
        <nav class="app-header navbar navbar-expand navbar-dark bg-secondary">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <span class="nav-link" data-lte-toggle="sidebar"><i class="bi bi-list"></i></span>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <span class="nav-link">@GlobalUI.PageTitle</span>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-widget="navbar-search" role="button" aria-label="Search">
                            <i class="bi bi-search"></i>
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link" data-bs-toggle="dropdown" href="#" aria-label="Messages">
                            <i class="bi bi-chat-text"></i>
                            <span class="navbar-badge badge text-bg-danger">3</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            <!-- Messages here (unchanged for brevity) -->
                            <a href="#" class="dropdown-item dropdown-footer">See All Messages</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link" data-bs-toggle="dropdown" href="#" aria-label="Notifications">
                            <i class="bi bi-bell-fill"></i>
                            <span class="navbar-badge badge text-bg-warning">15</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            <span class="dropdown-item dropdown-header">15 Notifications</span>
                            <!-- Notifications here (unchanged for brevity) -->
                            <a href="#" class="dropdown-item dropdown-footer">See All Notifications</a>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen" aria-label="Fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-label="User Menu">
                            <img src="@userImage" class="user-image rounded-circle shadow" alt="User Image" />
                            <span class="d-none d-md-inline">@userName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            @await Component.InvokeAsync("ProfileOverlay")
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
        <!-- Sidebar -->
        <aside class="main-sidebar app-sidebar bg-body-secondary shadow sidebar-expand-lg" data-bs-theme="dark">
            <div class="sidebar-brand text-center p-2" style="height: auto; min-height: fit-content; overflow: visible; white-space: normal; text-align: center;">
                <a asp-action="Index" asp-controller="Home" class="d-block text-decoration-none">
                    <img src="~/Images/Institute/@instituteLogo" alt="Logo" class="brand-image mb-2" style="max-height: 60px; width: auto;" />
                    <span class="brand-text fw-light d-block institute-name text-light">@instituteName</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    @await Component.InvokeAsync("Navigation")
                </nav>
            </div>
        </aside>
        <!-- Main Content -->
        <main class="app-main">
        <!-- 
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h5 class="mb-0">@GlobalUI.PageTitle</h5>
                        </div>
                    </div>
                </div>
            </div>
            -->
            <div class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>
        <!-- Footer -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">Anything you want</div>
            <strong>
                Copyright &copy; 2020&nbsp;
                <a href="https://nobleschoolbd.com" class="text-decoration-none">NRS</a>.
            </strong>
            All rights reserved.
        </footer>
    </div>
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/bootstrap-5.3.8-dist/js/bootstrap.min.js"></script>
    <script src="~/lib/theme/adminlte/js/overlayscrollbars.browser.es6.min.js"></script>
    <script src="~/lib/theme/adminlte/js/popper.min.js"></script>
    <script src="~/lib/theme/adminlte/js/bootstrap.min.js"></script>
    <script src="~/lib/Theme/adminLte/js/adminlte.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/alertify/alertify.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const SIDEBAR_STATE_KEY = "sidebar-state";
            const body = document.body;
            const savedState = localStorage.getItem(SIDEBAR_STATE_KEY);
            if (savedState === "collapsed") {
                body.classList.remove("sidebar-open");
                body.classList.add("sidebar-collapse");
            } else if (savedState === "open") {
                body.classList.remove("sidebar-collapse");
                body.classList.add("sidebar-open");
            }
            document.addEventListener('open.lte.push-menu', function () {
                localStorage.setItem(SIDEBAR_STATE_KEY, "open");
            });
            document.addEventListener('collapse.lte.push-menu', function () {
                localStorage.setItem(SIDEBAR_STATE_KEY, "collapsed");
            });
            const observer = new MutationObserver(function () {
                if (body.classList.contains("sidebar-collapse")) {
                    localStorage.setItem(SIDEBAR_STATE_KEY, "collapsed");
                } else if (body.classList.contains("sidebar-open")) {
                    localStorage.setItem(SIDEBAR_STATE_KEY, "open");
                }
            });
            observer.observe(body, { attributes: true, attributeFilter: ['class'] });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
